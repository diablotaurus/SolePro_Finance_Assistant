# ============================================
# SOLEPRO FINANCE ASSISTANT - ENVIRONMENT VARS
# ============================================

# Application
APP_ENV=development  # development, testing, production
APP_DEBUG=True
APP_SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
# For SQLite (development):
DATABASE_URL=sqlite:///./data/finances.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/solepro_finance

# Database Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=False

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=123456789,987654321  # Comma-separated user IDs
TELEGRAM_LOG_LEVEL=INFO
TELEGRAM_ADMIN_CHAT_ID=123456789

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Settings
CURRENCY=RUB
DATE_FORMAT=%d.%m.%Y
TIMEZONE=Europe/Moscow

# Features
ENABLE_AUTO_BACKUP=True
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# Export
EXPORT_PATH=./exports
EXPORT_MAX_ROWS=10000

# Security
ENCRYPTION_KEY=your-encryption-key-change-in-production
ENABLE_DATA_ENCRYPTION=False